# Placeholders only. Do not put real keys here.
# EXPO_PUBLIC_EXAMPLE_ENV_VAR has been removed and must not be reintroduced.

EXPO_NO_CAPABILITY_SYNC=1

# Crash reports stay off while this is a placeholder.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Optional features. Default off. No paid call, no account, no news fetch.
EXPO_PUBLIC_FEATURE_AI=false
EXPO_PUBLIC_FEATURE_NEWS=false
EXPO_PUBLIC_FEATURE_ACCOUNT=false

# Phase 2, server only. Never prefix OPENAI_API_KEY with EXPO_PUBLIC_.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# EXPO_PUBLIC_NEWS_FEED_URL=YOUR_NEWS_FEED_URL
